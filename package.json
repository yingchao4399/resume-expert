{
  "name": "resume-expert",
  "version": "1.13.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "app:local": "node scripts/start-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:e2e": "node scripts/start-e2e-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-local-e2e.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "eval:validate": "node evals/runner.mjs validate",
    "eval:mock": "node evals/runner.mjs mock",
    "eval:career": "node evals/career-eval.mjs",
    "eval:jd": "vitest run src/lib/jd/jd-eval.test.ts src/lib/jd/deep-analysis.test.ts",
    "eval:consolidation": "vitest run src/lib/jd/consolidation-eval.test.ts",
    "eval:readiness": "vitest run src/lib/jd/readiness-eval.test.ts",
    "eval:consolidation:ai": "node scripts/eval-consolidation-live.mjs",
    "eval:ai": "node evals/runner.mjs ai",
    "eval:compare": "node evals/runner.mjs compare",
    "eval:report": "node evals/runner.mjs report",
    "verify:local": "node scripts/verify-local.mjs",
    "prompt:validate": "node scripts/validate-prompts.mjs",
    "smoke:analysis": "node scripts/smoke-analysis.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
